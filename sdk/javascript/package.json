{
  "name": "yolotrace",
  "version": "0.1.0",
  "description": "Open-source, self-hosted observability and debugging for AI agents",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "audit": "npm audit --omit=dev",
    "check": "npm run typecheck && npm run test && npm run audit"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
